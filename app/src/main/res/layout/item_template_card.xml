<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardTemplate"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="5dp"
    android:background="@drawable/bg_neon_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Exact Vector Neon Thumbnail Preview -->
    <com.example.neondraw.TemplateThumbnailView
        android:id="@+id/thumbnailView"
        android:layout_width="68dp"
        android:layout_height="68dp"
        android:layout_gravity="center" />

    <TextView
        android:id="@+id/tvTemplateTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="Ngôi sao"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvTemplateCategory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:text="Dễ thương"
        android:textColor="#88FFFFFF"
        android:textSize="10sp" />

</LinearLayout>

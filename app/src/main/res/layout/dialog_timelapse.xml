<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_glass_rounded"
    android:orientation="vertical"
    android:padding="16dp">

    <!-- Top bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_video"
            app:tint="#FF007F" />

        <TextView
            android:id="@+id/tvTimelapseTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/video_replay_title"
            android:textColor="#FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnCloseTimelapse"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Close"
            android:src="@drawable/ic_clear"
            app:tint="#FFFFFF" />
    </LinearLayout>

    <!-- Preview Canvas Display -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_marginTop="12dp"
        android:background="#050505">

        <ImageView
            android:id="@+id/ivTimelapsePreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Drawing Preview"
            android:scaleType="fitCenter" />

        <!-- Overlay play icon when paused -->
        <ImageView
            android:id="@+id/ivCenterPlay"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_glass_circle"
            android:padding="14dp"
            android:src="@drawable/ic_play"
            android:visibility="gone"
            app:tint="#39FF14" />
    </FrameLayout>

    <!-- Progress Scrubber -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <SeekBar
            android:id="@+id/sbTimelapseProgress"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:max="1000"
            android:progress="0"
            android:progressBackgroundTint="#44FFFFFF"
            android:progressTint="#FF007F"
            android:thumbTint="#FF007F" />

        <TextView
            android:id="@+id/tvTimelapseProgressText"
            android:layout_width="45dp"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:text="0%"
            android:textColor="#FF007F"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Controls Row: Play/Pause, Replay, Speed -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPlayPause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_glass_circle"
            android:contentDescription="Play/Pause"
            android:src="@drawable/ic_play"
            app:tint="#00FFFF" />

        <ImageButton
            android:id="@+id/btnReplay"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Replay"
            android:src="@drawable/ic_restart"
            app:tint="#FFFFFF" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <!-- Speed selector -->
        <TextView
            android:id="@+id/btnSpeed1x"
            android:layout_width="38dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center"
            android:text="1x"
            android:textColor="#00FFFF"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/btnSpeed2x"
            android:layout_width="38dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center"
            android:text="2x"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/btnSpeed4x"
            android:layout_width="38dp"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/bg_glass_pill"
            android:gravity="center"
            android:text="4x"
            android:textColor="#FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Export Button & Status -->
    <ProgressBar
        android:id="@+id/pbExportVideo"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="12dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#39FF14"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvExportStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textColor="#39FF14"
        android:textSize="12sp"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnExportMp4"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_glass_pill"
        android:text="@string/export_mp4_video"
        android:textColor="#39FF14"
        android:textSize="14sp"
        android:textStyle="bold" />

</LinearLayout>
